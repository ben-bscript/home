# Daikin Onecta Cloud API — create an app at https://developer.cloud.daikineurope.com
DAIKIN_CLIENT_ID=
DAIKIN_CLIENT_SECRET=
# Must match the redirect URI registered for the app exactly. Daikin requires https
# and blocks "localhost" and IP addresses; localtest.me resolves to 127.0.0.1.
DAIKIN_REDIRECT_URI=https://home.localtest.me:3443/api/auth/daikin/callback

# Renson Waves: found by scanning the local network; set a static IP as fallback.
RENSON_WAVES_HOST=

# Zigbee lights: the MQTT broker Zigbee2MQTT publishes on (see zigbee/README.md).
# ZIGBEE_MQTT_URL=mqtt://localhost:1883
# ZIGBEE_MQTT_USERNAME=
# ZIGBEE_MQTT_PASSWORD=
# ZIGBEE_BASE_TOPIC=zigbee2mqtt

# API_PORT=3001
# CLIENT_URL=http://localhost:5173
